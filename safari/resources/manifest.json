{
  "manifest_version": 3,
  "name": "Thirduni Post Rescue",
  "version": "1.7.0",
  "description": "Fixes the Page not found error on Thirduni community posts. Shows the post, its replies and the sidebar instead of the 404.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://thirduni.com/course/*"
      ],
      "js": [
        "fix.js"
      ],
      "run_at": "document_start"
    }
  ]
}
